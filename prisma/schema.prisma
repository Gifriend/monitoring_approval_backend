// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Division {
  Manager
  Dalkon
  Engineer
  Vendor
}

enum Status {
  submitted
  inReviewConsultant
  inReviewEngineering
  inReviewManager
  approved
  approvedWithNotes
  returnForCorrection
  rejected
  overdue
}

enum ApprovalType {
  protection
  civil
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String?
  password     String
  division     Division
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  refreshToken String?

  submittedDocuments Document[]        @relation("SubmittedDocuments")
  reviewedDocuments  Document[]        @relation("ReviewedDocuments")
  approvals          Approval[]
  uploadedVersions   DocumentVersion[]

  @@index([email, division])
}

model Contract {
  id             String     @id @default(uuid())
  contractNumber String     @unique
  contractDate   DateTime
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  documents      Document[]
}

model Document {
  id              Int       @id @default(autoincrement())
  name            String
  filePath        String
  status          Status    @default(submitted)
  // overallDeadline DateTime?

  documentType String?
  contractId   String?
  contract     Contract? @relation(fields: [contractId], references: [id])

  submittedById Int
  submittedBy   User @relation("SubmittedDocuments", fields: [submittedById], references: [id])

  reviewedById Int?
  reviewedBy   User? @relation("ReviewedDocuments", fields: [reviewedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  remarks   String?

  approvals Approval[]

  progress      String[] 
  latestVersion Int               @default(1) 
  versions      DocumentVersion[] 
  returnRequestedBy  Division?

  @@index([submittedById])
  @@index([reviewedById])
  @@index([contractId])
}

model DocumentVersion {
  id           String   @id @default(cuid())
  filePath     String
  version      Int
  createdAt    DateTime @default(now())
  documentId   Int
  document     Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploadedById Int
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])

  @@unique([documentId, version])
  @@index([documentId])
  @@index([uploadedById])
}

model Approval {
  id           Int      @id @default(autoincrement())
  document     Document @relation(fields: [documentId], references: [id])
  documentId   Int
  type         String
  approvedBy   User     @relation(fields: [approvedById], references: [id])
  approvedById Int

  status    String
  notes     String?
  deadline  DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([documentId, deadline])
  @@index([approvedById, deadline])
  @@index([status, deadline])
}
